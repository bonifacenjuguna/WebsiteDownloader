BOT_TOKEN=123456:ABC-your-token-from-BotFather
# Optional: comma-separated Telegram user IDs allowed to use the bot (empty = everyone)
ALLOWED_USERS=
# Optional tuning
ENABLE_BROWSER=true
MAX_FILE_MB=42
# Target size of each ZIP part sent to Telegram (hard cap is 50 MB)
PART_MB=40
MAX_TOTAL_MB=120
MAX_FILES=1500
JOB_TIMEOUT_SEC=150
QUEUE_CONCURRENCY=2
QUEUE_MAX_WAITING=10
COOLDOWN_SEC=20

# --- v1.1: Postgres + Redis (both optional; bot falls back to in-memory if missing) ---
# On Railway use references: DATABASE_URL=${{Postgres.DATABASE_URL}}  REDIS_URL=${{Redis.REDIS_URL}}
DATABASE_URL=
REDIS_URL=
PGSSL=false
# YOUR Telegram numeric ID (send /myid to the bot to see it). Enables /stats /ban /unban
ADMIN_IDS=
CACHE_TTL_MIN=360
NEG_CACHE_SEC=300
RETENTION_DAYS=90
BROWSER_CONCURRENCY=2
BROWSER_RECYCLE_AFTER=40

# --- v1.2.1 ---
# New (non-cached) downloads per user per UTC day. 0 = unlimited. Admins are exempt.
DAILY_LIMIT=30

# --- v1.2.3 ---
# Auto-set the bot's description, short description, name and menu button at startup (set false to manage in @BotFather)
PROFILE_SYNC=true
BOT_NAME=Website Downloader

# --- v1.5.0: whole-site crawl (the default for every link) ---
SITE_MAX_PAGES=300
SITE_MAX_PAGES_BROWSER=60
SITE_DEPTH=10
SITE_MAX_FILES=300
SITE_MAX_DIRS=60
SITE_MAX_TOTAL_MB=500
SITE_MAX_PARTS=12
SITE_TIMEOUT_SEC=480
SITE_RESPECT_ROBOTS=true

# --- v1.6.0 ---
# Admin domain block list (comma-separated). Admins can also use /block and /unblock at runtime. Subdomains are included.
BLOCKED_DOMAINS=
# New builds of ONE site per user per day (0 = unlimited) and across all users (0 = unlimited). Cached copies are free.
DOMAIN_DAILY_CAP=5
DOMAIN_GLOBAL_DAILY=60
# Failed attempts per hour before a short pause for that user
FAIL_STRIKES=8
FAIL_PAUSE_MIN=15
# Minimum gap (ms) between requests to one host. Doubles automatically on 429/503, relaxes again afterwards.
HOST_GAP_MS=50
# Read sitemap.xml to find pages (max URLs taken from it)
SITE_SITEMAP=true
SITE_SITEMAP_URLS=1000
# Shrink big images before leaving anything out (needs the optional `sharp` package; skipped if it is missing)
IMAGE_COMPRESS=true
# Verify every local link before sending (broken ones are pointed back at the live URL)
LINK_CHECK=true
# Continue unfinished jobs after a restart (needs Redis) and how old a job may be to resume
RESUME=true
RESUME_MAX_MIN=30
# /health endpoint (uses PORT when set). Set HEALTH=false to turn it off.
HEALTH=true
# Recycle Chromium when the container uses more than this share of its memory limit
BROWSER_MEM_RATIO=0.85
