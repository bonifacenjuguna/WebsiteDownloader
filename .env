# Website Downloader configuration.
# Generated by "npm run env" from scripts/env-vars.js. Edit that file, not this one.
#
# Every value below is the bot's built-in default, so the bot behaves the same with this file or without it.
# Change only what you need.
#   Railway: Variables -> Raw Editor -> paste only the lines you want to change.
#   Local:   npm run dev   (reads this file)
# Blank means "off / not set". Never commit real secrets: .env is in .gitignore and .dockerignore.

# ---------- Connections and identity ----------
# Only BOT_TOKEN is required. Add DATABASE_URL, REDIS_URL and ADMIN_IDS for the full feature set.
# REQUIRED. The token from @BotFather.
BOT_TOKEN=
# Postgres connection string (Railway: ${{Postgres.DATABASE_URL}}). Enables history, analytics and a durable cache.
DATABASE_URL=
# Redis connection string (Railway: ${{Redis.REDIS_URL}}). Enables the fast cache, locks, limits and resume after restarts.
REDIS_URL=
# Set true if your Postgres requires SSL.
PGSSL=false
# Your Telegram numeric ID (send /myid to the bot). Comma-separate several. Enables /ping, /stats, /ban, /block and admin notices.
ADMIN_IDS=
# DM admins when the bot starts and shuts down.
ADMIN_NOTIFY=true
# Comma-separated Telegram IDs allowed to use the bot. Blank = everyone.
ALLOWED_USERS=
# The bot's display name (kept in sync on start).
BOT_NAME=Website Downloader
# Keep the bot's Telegram profile (description, menu button) in sync on every start.
PROFILE_SYNC=true

# ---------- People and limits ----------
# Who may use the bot and how much.
# New (non-cached) downloads per user per day, UTC. 0 = unlimited. Admins are exempt.
DAILY_LIMIT=30
# Seconds a user must wait between downloads.
COOLDOWN_SEC=20
# New builds of ONE site per user per day. 0 = unlimited.
DOMAIN_DAILY_CAP=5
# New builds of ONE site per day across all users. 0 = unlimited.
DOMAIN_GLOBAL_DAILY=60
# Failed attempts per hour before a short pause for that user.
FAIL_STRIKES=8
# Length of that pause, in minutes.
FAIL_PAUSE_MIN=15
# Comma-separated sites nobody can download (subdomains included). Admins can also use /block.
BLOCKED_DOMAINS=
# Jobs running at once.
QUEUE_CONCURRENCY=2
# Jobs allowed to wait; more get "I'm busy".
QUEUE_MAX_WAITING=10

# ---------- Crawling a site ----------
# How much of a site is saved.
# Maximum pages saved per site.
SITE_MAX_PAGES=300
# Maximum pages for sites that build every page with JavaScript (each needs a browser load).
SITE_MAX_PAGES_BROWSER=60
# How many link-clicks deep the crawl goes.
SITE_DEPTH=10
# Folder listings: files to download. Whole sites: linked documents.
SITE_MAX_FILES=300
# Folder listings: folders to walk.
SITE_MAX_DIRS=60
# Total size of one site before things are left out.
SITE_MAX_TOTAL_MB=500
# Maximum ZIP parts for one site.
SITE_MAX_PARTS=12
# Time limit for one site.
SITE_TIMEOUT_SEC=480
# Skip pages that robots.txt asks bots not to copy. Set false to copy them.
SITE_RESPECT_ROBOTS=true
# Read sitemap.xml to find pages.
SITE_SITEMAP=true
# Most URLs taken from a sitemap.
SITE_SITEMAP_URLS=1000

# ---------- Files and ZIPs ----------
# Telegram upload sizes and per-file limits.
# Target size of each ZIP part (Telegram allows 50 MB; with a self-hosted Bot API the default becomes 1500).
PART_MB=40
# Largest single file saved (with a self-hosted Bot API the default becomes 150).
MAX_FILE_MB=42
# Default size cap for a single job when a caller does not set its own.
MAX_TOTAL_MB=120
# Default file-count cap for a single job when a caller does not set its own.
MAX_FILES=1500
# Default time cap for a single job when a caller does not set its own.
JOB_TIMEOUT_SEC=150

# ---------- Speed ----------
# Downloads, caching and size budgeting.
# Files downloaded at once.
ASSET_CONCURRENCY=24
# Pages of a crawl fetched at once.
PAGE_CONCURRENCY=8
# Simultaneous requests to one host (halves automatically when a site pushes back).
HOST_MAX_CONCURRENT=8
# Minimum gap between requests to one host, in ms (grows automatically on 429/503).
HOST_GAP_MS=8
# Give up on a file when no data arrives for this many seconds.
ASSET_STALL_SEC=10
# Size of the shared cache for popular library and font files. 0 = off.
SHARED_CACHE_MB=256
# Shrink big images before leaving anything out (needs the optional sharp package).
IMAGE_COMPRESS=true
# Verify every local link before sending; broken ones point back to the live site.
LINK_CHECK=true

# ---------- Caching and history ----------
# How long things are remembered.
# Minutes a saved copy is sent as-is.
CACHE_TTL_MIN=1440
# Copies up to this old are re-checked with the site and re-sent when nothing changed.
STALE_MAX_DAYS=7
# Seconds a failure is remembered, so the same dead link is not retried at once.
NEG_CACHE_SEC=300
# Days history is kept (people can choose 7, 30 or never with /privacy).
RETENTION_DAYS=90

# ---------- Chromium (dynamic and protected sites) ----------
# Used automatically when a plain fetch is not enough.
# Use Chromium when needed. false = plain fetching only.
ENABLE_BROWSER=true
# Pages rendered by Chromium at once.
BROWSER_CONCURRENCY=1
# Close Chromium after this many idle minutes (it starts again on demand).
BROWSER_IDLE_MIN=5
# true = keep Chromium running from startup (uses about 300 MB).
BROWSER_WARM=false
# Restart Chromium after this many jobs to keep memory flat.
BROWSER_RECYCLE_AFTER=40
# Restart an idle Chromium when the container uses more than this share of its memory.
BROWSER_MEM_RATIO=0.85

# ---------- Memory and disk protection ----------
# Keeps a small instance from running out of room.
# An extra parallel job waits while the container is above this share of memory.
MEM_ADMIT_RATIO=0.92
# An extra parallel job waits while the temp disk has less free space than this. 0 = off.
DISK_MIN_MB=700

# ---------- Restarts, deploys and big files ----------
# Resume, webhook mode and the self-hosted Bot API.
# Continue unfinished jobs after a restart (needs Redis).
RESUME=true
# Oldest interrupted job, in minutes, that is still resumed.
RESUME_MAX_MIN=30
# On shutdown, wait this long for running jobs to finish.
DRAIN_SECONDS=8
# Public host of this service (no https://) to receive updates by webhook, so deploys lose no messages. Blank = polling.
WEBHOOK_DOMAIN=
# Self-hosted Telegram Bot API server URL. Lifts the 50 MB upload limit to 2 GB.
TELEGRAM_API_URL=

# ---------- Health, metrics and logs ----------
# Watching the bot.
# Serve GET /health. false = no web server unless webhook mode needs it.
HEALTH=true
# Port for the web server when Railway's PORT is not set (local use).
HEALTH_PORT=
# Enables GET /metrics (Prometheus). Send it as "Authorization: Bearer <token>".
METRICS_TOKEN=
# json = one JSON object per log event. Blank = readable lines.
LOG_FORMAT=
